---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Reshelved</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ r.to | fullUrl }}">
{# Site-relative: the base plugin adds the path prefix, refresh URLs included. #}
<meta http-equiv="refresh" content="0; url={{ r.to }}">
</head>
<body>
<p>This entry has been reshelved. It now lives at <a href="{{ r.to }}">{{ r.to }}</a>.</p>
</body>
</html>
