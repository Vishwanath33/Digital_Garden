<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{% if title and not home %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ summary or description or site.description }}">
<meta name="author" content="{{ site.author.name }}">
<meta name="color-scheme" content="light dark">

<link rel="canonical" href="{{ page.url | fullUrl }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' | fullUrl }}">

<meta property="og:type" content="{% if isNote %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ summary or description or site.description }}">
<meta property="og:url" content="{{ page.url | fullUrl }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta name="twitter:card" content="summary">

{# The attractor's two lobes, as a favicon. #}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230b0e13'/%3E%3Cpath d='M16 5C10 7 6 12 8 17c2 4 7 4 8 1s7-3 9 1c2 4-3 8-9 7' fill='none' stroke='%23ff683a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E">

<link rel="preload" href="/assets/fonts/newsreader-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/library.css">
{% if isNote or usesGraph %}<link rel="prefetch" id="graph-src" href="/graph.json" as="fetch" crossorigin>{% endif %}

<script>
  /* Set the theme before first paint so nothing flashes. */
  (function () {
    try {
      var t = localStorage.getItem("library-theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  })();
</script>
</head>

<body data-page="{{ page.url }}">
<a class="skip-link" href="#main">Skip to the text</a>
<a hidden id="search-src" href="/search.json"></a>

<canvas class="background" data-lorenz aria-hidden="true"></canvas>

<div class="folio{% if home %} folio--home{% endif %}">

  <div class="page">
    <header class="running-head">
      <nav class="running-head__nav" aria-label="Primary">
        <a href="/"{% if home %} aria-current="page"{% endif %}>Home</a>
        <a href="/tags/"{% if page.url == '/tags/' %} aria-current="page"{% endif %}>Subjects</a>
        <a href="/map/"{% if page.url == '/map/' %} aria-current="page"{% endif %}>Map</a>
        <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        <button type="button" class="running-head__button" data-search-open aria-label="Search the library (press /)">Search <kbd>/</kbd></button>
        <button type="button" class="running-head__button" data-theme-toggle aria-label="Switch theme">Dark</button>
        <button type="button" class="running-head__button" data-motion-toggle aria-pressed="false">Still</button>
      </nav>
    </header>

    <main id="main" class="text">
      {{ content | safe }}
    </main>

    <footer class="foot">
      <p>
        <span>kept by {{ site.author.name }}</span> ·
        <a href="/colophon/">colophon</a>{% if site.sourcePublic %} · <a href="{{ site.repo }}">source</a>{% endif %}
      </p>
    </footer>
  </div>


</div>

<div class="overlay search" data-search hidden>
  <div class="search__box" role="dialog" aria-modal="true" aria-label="Search the library">
    <label class="search__label" for="search-input">Search the library</label>
    <input class="search__input" id="search-input" type="search" placeholder="A word, a subject, a shelf…" autocomplete="off" spellcheck="false" aria-controls="search-results" data-search-input>
    <ul class="search__results" id="search-results" role="listbox" data-search-results></ul>
    <p class="search__empty" data-search-empty hidden>Nothing in the library matches that.</p>
    <p class="search__hint">↑ ↓ to choose · return to open · esc to close</p>
  </div>
</div>

<script src="/assets/js/lorenz.js" defer></script>
<script src="/assets/js/library.js" defer></script>
{% if 'data-plate' in content %}<script src="/assets/js/plate.js" defer></script>{% endif %}
{% if isNote or usesGraph %}<script src="/assets/js/graph.js" defer></script>{% endif %}
</body>
</html>
