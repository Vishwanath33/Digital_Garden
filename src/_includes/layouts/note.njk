---
layout: layouts/base.njk
---
{% set st = site.stages[stage] or site.stages.manuscript %}

<article>
  <header class="entry-head">
    <h1 class="entry-title">{{ title }}</h1>
    {% if summary %}<p class="entry-summary">{{ summary }}</p>{% endif %}

    <div class="meta">
      <dl>
        <dt>Stage</dt>
        <dd><span class="stage stage--{{ st.label }}" title="{{ st.blurb }}">{{ st.label }}</span></dd>
      </dl>
      <dl>
        <dt>Written</dt>
        <dd><time datetime="{{ (created or page.date) | shortDate }}">{{ (created or page.date) | readableDate }}</time></dd>
      </dl>
      {% if updated %}
      <dl>
        <dt>Revised</dt>
        <dd><time datetime="{{ updated | shortDate }}">{{ updated | readableDate }}</time></dd>
      </dl>
      {% endif %}
      {% if certainty %}
      <dl>
        <dt>Certainty</dt>
        <dd>{{ certainty }}</dd>
      </dl>
      {% endif %}
      {% if importance %}
      <dl>
        <dt>Importance</dt>
        <dd>{{ importance }}/10</dd>
      </dl>
      {% endif %}
      <dl>
        <dt>Length</dt>
        <dd>{{ content | readingTime }} min</dd>
      </dl>
      {% if tags and tags.length %}
      <dl class="meta__wide">
        <dt>Subjects</dt>
        <dd>
          <span class="tag-list">
            {% for tag in tags %}<a class="tag" href="/tags/#{{ tag }}">{{ tag }}</a>{% endfor %}
          </span>
        </dd>
      </dl>
      {% endif %}
    </div>
  </header>

  <div class="prose prose--dropcap" data-sidenotes>
    {{ content | safe }}
  </div>

  {% if site.sourcePublic %}
  <p class="entry-source">
    <a href="{{ site.repo }}/commits/{{ site.repoBranch }}/src/notes/{{ page.fileSlug }}.md">Revision history</a>
    <span aria-hidden="true">·</span>
    <a href="{{ site.repo }}/blob/{{ site.repoBranch }}/src/notes/{{ page.fileSlug }}.md">Source</a>
  </p>
  {% endif %}
</article>
