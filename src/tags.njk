---
layout: layouts/base.njk
title: Subjects
permalink: /tags/index.html
---
<header class="entry__head">
  <p class="kicker">Subject index</p>
  <h1 class="entry__title">Subjects</h1>
  <p class="entry__dek">Every subject heading in the library, alphabetically, with the entries filed under it.</p>
</header>

<nav class="letters" aria-label="Subjects">
  {% for entry in collections.tagIndex | sort(false, false, "tag") %}<a href="#{{ entry.tag }}">{{ entry.tag }}<sup>{{ entry.count }}</sup></a>{% endfor %}
</nav>

<div class="subject-index">
  {% for entry in collections.tagIndex | sort(false, false, "tag") %}
  <section class="subject" id="{{ entry.tag }}">
    <h2 class="subject__head">{{ entry.tag | capitalize }}</h2>
    <ul>
      {% for note in entry.notes %}
      {%- set acc = collections.accession | lookup(note.url) -%}
      <li><a href="{{ note.url }}"><span class="toc__no">{{ acc.number }}</span>{{ note.data.title }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
