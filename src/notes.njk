---
layout: layouts/base.njk
title: Catalogue
permalink: /notes/index.html
---
<header class="entry__head">
  <p class="kicker">Accessions, most recently revised first</p>
  <h1 class="entry__title">Catalogue</h1>
  <p class="entry__dek">
    Every entry in the library. The stage is a claim about maturity, not
    length: a manuscript may be long and wrong, a bound entry short and
    load-bearing.
  </p>
</header>

{% if collections.notes.length %}
<form class="filter" role="search" onsubmit="return false">
  <label class="filter__label" for="filter">Filter</label>
  <input class="filter__input" id="filter" type="search" autocomplete="off"
         placeholder="title, shelf, subject…" data-filter="#catalogue">
</form>
{% endif %}

<div id="catalogue">
  {% for group in collections.notes | byYear %}
  <section data-group>
    <h2 class="year">{{ group.year }}</h2>
    <ol class="toc">
      {% for note in group.notes %}
      {%- set acc = collections.accession | lookup(note.url) -%}
      {%- set st = site.stages[note.data.stage] or site.stages.manuscript -%}
      <li class="toc__item" data-searchable="{{ (note.data.title ~ ' ' ~ (note.data.shelf or 'general') ~ ' ' ~ (note.data.summary or '') ~ ' ' ~ (note.data.tags | join(' '))) | lower }}">
        <a class="toc__link" href="{{ note.url }}">
          <span class="toc__no">{{ acc.number }}</span>
          <span class="toc__line"><span class="toc__title">{{ note.data.title }}</span><span class="toc__leader" aria-hidden="true"></span><span class="toc__date">{{ (note.data.updated or note.date) | shortDate }}</span></span>
        </a>
        <p class="toc__meta">
          <span title="{{ st.blurb }}"><span aria-hidden="true">{{ st.glyph }}</span> {{ st.label }}</span>
          <span>{{ note.data.shelf or "General" }}</span>
          {% if note.data.certainty %}<span>certainty {{ note.data.certainty }}</span>{% endif %}
          {% for tag in note.data.tags %}<a href="/tags/#{{ tag }}">{{ tag }}</a>{% endfor %}
        </p>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endfor %}
</div>

{% if collections.notes.length %}
<p class="empty-note" data-filter-empty hidden>Nothing in the catalogue matches that.</p>
{% else %}
<p class="empty-note">Nothing has been catalogued yet.</p>
{% endif %}
