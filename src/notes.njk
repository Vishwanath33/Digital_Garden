---
layout: layouts/base.njk
title: Catalogue
permalink: /notes/index.html
---
<h1 class="page-title">Catalogue</h1>
<p class="lede">
  Every entry in the library, most recently revised first. The stage is a
  claim about maturity, not length: a
  <span class="stage stage--manuscript">manuscript</span> may be long and
  wrong, a <span class="stage stage--bound">bound</span> entry short and
  load-bearing.
</p>

<div class="filter-row">
  <form role="search" onsubmit="return false">
    <label class="sr-only" for="filter">Filter the catalogue</label>
    <input class="filter-input" id="filter" type="search" autocomplete="off"
           placeholder="Filter by title, shelf, summary or subject…"
           data-filter="#catalogue">
  </form>
</div>

<div id="catalogue">
  {% for group in collections.notes | byYear %}
  <section data-group>
    <h2 class="group-heading">{{ group.year }}</h2>
    <ul class="entry-list">
      {% for note in group.notes %}
      {% set st = site.stages[note.data.stage] or site.stages.manuscript %}
      <li class="entry" data-searchable="{{ (note.data.title ~ ' ' ~ (note.data.shelf or '') ~ ' ' ~ (note.data.summary or '') ~ ' ' ~ (note.data.tags | join(' '))) | lower }}">
        <div class="entry__head">
          <h3 class="entry__title"><a href="{{ note.url }}">{{ note.data.title }}</a></h3>
          <span class="entry__date">{{ (note.data.updated or note.date) | shortDate }}</span>
        </div>
        {% if note.data.summary %}<p class="entry__summary">{{ note.data.summary }}</p>{% endif %}
        <div class="entry__meta">
          <span class="stage stage--{{ st.label }}">{{ st.label }}</span>
          {% if note.data.shelf %}<span>{{ note.data.shelf }}</span>{% endif %}
          {% if note.data.certainty %}<span>certainty: {{ note.data.certainty }}</span>{% endif %}
          {% for tag in note.data.tags %}<span>#{{ tag }}</span>{% endfor %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>

<p class="empty-note" data-filter-empty hidden>Nothing in the catalogue matches that.</p>
